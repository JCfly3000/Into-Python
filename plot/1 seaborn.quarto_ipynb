{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"seaborn chart\"\n",
        "execute:\n",
        "  warning: false\n",
        "  error: false\n",
        "\n",
        "format:\n",
        "  html:\n",
        "    toc: true\n",
        "    toc-location: right\n",
        "    code-fold: show\n",
        "    code-tools: true\n",
        "    number-sections: true\n",
        "    code-block-bg: true\n",
        "    code-block-border-left: \"#31BAE9\"\n",
        "---\n",
        "\n",
        "![](images/logo-wide-lightbg.svg)\n",
        "\n",
        "Seaborn is a Python data visualization library based on matplotlib. It provides a high-level interface for drawing attractive and informative statistical graphics."
      ],
      "id": "ab526230"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import seaborn as sns\n",
        "print(sns.__version__)"
      ],
      "id": "38c2f01a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Import seaborn\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib\n",
        "\n",
        "# Apply the default theme\n",
        "#sns.set_theme()\n",
        "\n",
        "# Load an example dataset\n",
        "tips = sns.load_dataset(\"tips\")\n",
        "tips.head()"
      ],
      "id": "f3c1cca2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Scatter Plot"
      ],
      "id": "73588deb"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.scatterplot(data=tips,x='tip',y='total_bill')"
      ],
      "id": "f93dab0e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## color by group"
      ],
      "id": "14d0a261"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.scatterplot(data=tips,x='tip',y='total_bill',hue='sex')"
      ],
      "id": "572cc252",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## size by group"
      ],
      "id": "5abce275"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.scatterplot(data=tips,x='tip',y='total_bill',size='size')"
      ],
      "id": "71f7ed14",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# line Plot"
      ],
      "id": "1f0a7635"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "dowjones= sns.load_dataset(\"dowjones\")\n",
        "dowjones.head()"
      ],
      "id": "7974dcc4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.lineplot(data=dowjones,x='Date',y='Price')"
      ],
      "id": "55f192d4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## color by group\n"
      ],
      "id": "15e4618a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "import random\n",
        "#from siuba import _, mutate, filter, group_by, summarize,show_query\n",
        "#from siuba import *\n",
        "\n",
        "\n",
        "# Equivalent of: dowjones2 = dowjones >> mutate(type='old')\n",
        "dowjones2 = dowjones.copy()\n",
        "dowjones2['type'] = 'old'\n",
        "\n",
        "# Equivalent of: dowjones3 = dowjones >> mutate(Price=_.Price+random.random()*200, type='new')\n",
        "dowjones3 = dowjones.copy()\n",
        "dowjones3['Price'] = dowjones3['Price'] + random.random() * 200\n",
        "dowjones3['type'] = 'new'\n",
        "\n",
        "# Equivalent of: dowjones4 = pd.concat([dowjones2, dowjones3], ignore_index=True) >> arrange(_.Date)\n",
        "dowjones4 = pd.concat([dowjones2, dowjones3], ignore_index=True)\n",
        "dowjones4 = dowjones4.sort_values('Date').reset_index(drop=True)\n"
      ],
      "id": "02e263ce",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "dowjones4.head()"
      ],
      "id": "fbb230c9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.lineplot(data=dowjones4,x='Date',y='Price',hue='type')"
      ],
      "id": "8e6615e3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# histogram"
      ],
      "id": "93a575b5"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.histplot(data=tips,x='tip')"
      ],
      "id": "2d6e4a1b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## color by group"
      ],
      "id": "0c5fdd1a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.histplot(data=tips,x='tip',hue='sex',multiple=\"dodge\")"
      ],
      "id": "e1243c55",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# bar chart"
      ],
      "id": "0bff9eb6"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.barplot(data=tips,x='sex',y='tip',errorbar=None)"
      ],
      "id": "38c6d5b8",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## show number"
      ],
      "id": "c5867377"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "ax=sns.barplot(data=tips,x='sex',y='tip',errorbar=None)\n",
        "\n",
        "for i in ax.containers:\n",
        "    ax.bar_label(i,)\n"
      ],
      "id": "30e40e6a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## horizontal bar plot "
      ],
      "id": "a01feaa4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "ax=sns.barplot(data=tips,y='sex',x='tip',errorbar=None,orient = 'h')\n",
        "plt.show()"
      ],
      "id": "8892912c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# box plot"
      ],
      "id": "a59523ef"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.boxplot(data=tips,x='day',y='tip')"
      ],
      "id": "71e9b536",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## color by group"
      ],
      "id": "4abdc294"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.boxplot(data=tips,x='day',y='tip',hue='sex')"
      ],
      "id": "969c6a80",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# strip plot"
      ],
      "id": "f455ab15"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.stripplot(data=tips,x='day',y='tip')"
      ],
      "id": "e4ddf8c5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## color by group"
      ],
      "id": "e6e00ac6"
