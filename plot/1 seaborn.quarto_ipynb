    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.stripplot(data=tips,x='day',y='tip',hue='sex',dodge=True)"
      ],
      "id": "3f41080c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "join plot"
      ],
      "id": "c05a208f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.jointplot(data=tips,x='total_bill',y='tip',kind='reg')"
      ],
      "id": "ae57520c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Facet plot"
      ],
      "id": "6df3f58a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "g = sns.FacetGrid(data=tips, col=\"day\", hue=\"sex\")\n",
        "\n",
        "g.map_dataframe(sns.scatterplot, x=\"total_bill\", y=\"tip\")\n",
        "\n",
        "g.add_legend()"
      ],
      "id": "f3c738a1",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "make 2 plot per column"
      ],
      "id": "2e306139"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "g = sns.FacetGrid(data=tips, col=\"day\",col_wrap=2, hue=\"sex\")\n",
        "\n",
        "g.map_dataframe(sns.scatterplot, x=\"total_bill\", y=\"tip\")\n",
        "\n",
        "g.add_legend()"
      ],
      "id": "1e811ed9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "sub plot"
      ],
      "id": "46f9f8bb"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#sns.set()\n",
        "\n",
        "#define plotting region (1 rows, 2 columns)\n",
        "fig, axes = plt.subplots(1, 2)\n",
        "\n",
        "\n",
        "sns.boxplot(data=tips,x='day',y='tip',hue='sex',ax=axes[0])\n",
        "sns.boxplot(data=tips,x='day',y='tip',ax=axes[1])"
      ],
      "id": "ba6f100d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# chinese 显示中文 in Mac"
      ],
      "id": "560985ad"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# add following line\n",
        "plt.rcParams['font.family'] = ['Arial Unicode MS'] #用来正常显示中文标签\n",
        "plt.rcParams['axes.unicode_minus'] = False #用来正常显示负号\n",
        "sns.set_style('whitegrid',{'font.sans-serif':['Arial Unicode MS','Arial']})\n"
      ],
      "id": "cc100742",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# title,size,x y name\n",
        "\n",
        "## add title"
      ],
      "id": "e786aef9"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df = sns.load_dataset(\"tips\")\n",
        "\n",
        "ax=sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "\n",
        "ax.set_title(\"tips box plot \")"
      ],
      "id": "c4f0c163",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## adjust size"
      ],
      "id": "852cb3f0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "plt.clf()\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "ax=sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "ax.set_title(\"tips box plot \")\n",
        "\n",
        "plt.show()"
      ],
      "id": "c86c4fc7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## change x y name"
      ],
      "id": "a67d2391"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "ax=sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "ax.set_title(\"tips box plot \")\n",
        "ax.set(xlabel='x-axis label', ylabel='y-axis label')"
      ],
      "id": "449f6c56",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# applying themes\n",
        "\n",
        "::: {.panel-tabset .nav-pills}\n",
        "\n",
        "## darkgrid themes\n",
        "\n",
        "If you set the set_style function without any arguments the \"darkgrid\" theme will be used by default, which adds a gray background and white grid lines."
      ],
      "id": "eaff7bd0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import seaborn as sns\n",
        "\n",
        "df = sns.load_dataset(\"tips\")\n",
        "\n",
        "sns.set_theme()\n",
        "# Equivalent to:\n",
        "# sns.set_style(\"darkgrid\")\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)"
      ],
      "id": "33c050f1",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## whitegrid themes\n",
        "\n",
        "If you want to add gray grid lines but with a white background set this theme."
      ],
      "id": "1694c1c7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import seaborn as sns\n",
        "\n",
        "df = sns.load_dataset(\"tips\")\n",
        "sns.set_style(\"whitegrid\")\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)"
      ],
      "id": "e8fc50a9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## dark themes\n",
        "\n",
        "The \"dark\" theme is the same as \"darkgrid\" but without the grid lines."
      ],
      "id": "2b95534c"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import seaborn as sns\n",
        "\n",
        "df = sns.load_dataset(\"tips\")\n",
        "\n",
        "sns.set_style(\"dark\")\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)"
      ],
      "id": "0d21765a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## white themes\n",
        "\n",
        "The \"white\" theme is the same as \"whitegrid\" but without the gray grid lines."
      ],
      "id": "ee09f543"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import seaborn as sns\n",
        "\n",
        "df = sns.load_dataset(\"tips\")\n",
        "\n",
        "sns.set_style(\"white\")\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)"
      ],
      "id": "3657594c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## ticks themes\n",
        "\n",
        "The \"ticks\" theme is the same as the \"white\" theme but this theme adds ticks to the axes."
      ],
      "id": "4e247037"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import seaborn as sns\n",
        "\n",
        "df = sns.load_dataset(\"tips\")\n",
        "\n",
        "sns.set_style(\"ticks\")\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)"
      ],
      "id": "dc89ec55",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## fivethirtyeight themes"
      ],
      "id": "8792a8c1"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "plt.clf()\n",
        "\n",
        "plt.style.use('fivethirtyeight')\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "\n",
        "plt.show()"
      ],
      "id": "b199879d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## ggplot"
      ],
      "id": "00c8c3b4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "plt.clf()\n",
        "\n",
        "plt.style.use('ggplot')\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
      "id": "4fe76d69",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## tableau-colorblind10"
      ],
      "id": "75efd60a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "plt.clf()\n",
        "plt.style.use('tableau-colorblind10')\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
      "id": "b57b2efd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## dark_background"
      ],
      "id": "61c55712"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "plt.clf()\n",
        "plt.style.use('dark_background')\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
      "id": "6f50a6e2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        ":::\n",
        "\n",
        "\n",
        "# Save plot"
      ],
      "id": "0245c796"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import seaborn as sns\n",
        "\n",
        "df = sns.load_dataset(\"tips\")\n",
        "\n",
        "plt.clf()\n",
        "\n",
        "plt.style.use('default')\n",
        "\n",
        "sns.boxplot(x = \"day\", y = \"total_bill\", data = df)\n",
        "\n",
        "# Save the plot with desired size\n",
        "plt.savefig(\"output.png\", dpi=100, bbox_inches=\"tight\")\n"
      ],
      "id": "577ef11f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Animation plot"
      ],
      "id": "888c3953"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from celluloid import Camera"
      ],
      "id": "02e54edd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: false \n",
        "from celluloid import Camera\n",
        "from matplotlib import pyplot as plt\n",
        "\n",
        "fig = plt.figure()\n",
        "\n",
        "camera = Camera(fig)\n",
        "\n",
        "a=sns.lineplot(data=dowjones4,x='Date',y='Price',hue='type')\n",
        "\n",
        "hands, labs = a.get_legend_handles_labels()\n",
        "\n",
        "new_data=dowjones4.sample(50, random_state=42)\n",
        "\n",
        "new_data=new_data.sort_values(by=['Date'], ascending=True)\n",
        "\n",
        "for i in (new_data[\"Date\"]):\n",
        "  data=dowjones4.query('Date <= @i')\n",
        "  #print(data)\n",
        "  sns.lineplot(data=data,x='Date',y='Price',hue='type')\n",
        "  plt.legend(handles=hands, labels=labs)\n",
        "  camera.snap()\n",
        "\n",
