      "source": [
        "### append by column\n",
        "\n",
        "### Dropping NA values\n",
        "\n",
        "### keep NA values\n",
        "\n",
        "## group by\n",
        "\n",
        "### average,min,max,sum"
      ],
      "id": "8dab839d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to calculate the average, minimum, maximum, and sum of 'total_bill' grouped by 'sex'\n",
        "sql=\"select AVG(total_bill),min(total_bill),max(total_bill),sum(total_bill) from tips group by sex\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the DataFrame\n",
        "table"
      ],
      "id": "bedd549d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### count"
      ],
      "id": "490ac786"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to count records grouped by 'sex'\n",
        "sql=\"select sex,count(*) from tips group by 1\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the DataFrame\n",
        "table"
      ],
      "id": "fa0efc2a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
