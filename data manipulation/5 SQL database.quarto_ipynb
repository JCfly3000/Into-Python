      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"SQL database with python\"\n",
        "author: \"Tony Duan\"\n",
        "\n",
        "execute:\n",
        "  warning: false\n",
        "  error: false\n",
        "format:\n",
        "  html:\n",
        "    toc: true\n",
        "    toc-location: right\n",
        "    code-fold: show\n",
        "    code-tools: true\n",
        "    number-sections: true\n",
        "    code-block-bg: true\n",
        "    code-block-border-left: \"#31BAE9\"\n",
        "---\n",
        "\n",
        "![](images/1594917913096.png){width=\"600\"}\n",
        "\n",
        "# Connection with database"
      ],
      "id": "05270ae0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Import seaborn for loading sample datasets\n",
        "import seaborn as sns\n",
        "# Import pandas for data manipulation\n",
        "import pandas as pd\n",
        "# Import sqlite3 for SQLite database interaction\n",
        "import sqlite3\n",
        "\n",
        "# Load the 'tips' dataset from seaborn\n",
        "tips = sns.load_dataset(\"tips\")\n",
        "# Load the 'planets' dataset from seaborn\n",
        "planets=sns.load_dataset('planets')"
      ],
      "id": "b7746851",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## create database file pythonsqlite.db and copy tips data and planets data into database"
      ],
      "id": "557d216e"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| eval: false\n",
        "# Import the sqlite3 module\n",
        "import sqlite3\n",
        "# Create a connection to the SQLite database file 'pythonsqlite.db'\n",
        "db = sqlite3.connect('pythonsqlite.db')\n",
        "\n",
        "# Write the 'tips' DataFrame to a SQL table named 'tips', replacing it if it already exists\n",
        "tips.to_sql(name='tips', con=db,if_exists='replace')\n",
        "# Write the 'planets' DataFrame to a SQL table named 'planets', replacing it if it already exists\n",
        "planets.to_sql(name='planets', con=db,if_exists='replace')\n",
        "\n",
        "# Close the database connection\n",
        "db.close()"
      ],
      "id": "d83bea5f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## check all table in database"
      ],
      "id": "a1cd0507"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Connect to the SQLite database file 'pythonsqlite.db'\n",
        "db = sqlite3.connect('pythonsqlite.db')\n",
        "# Execute an SQL query to select table names from sqlite_master and read into a pandas DataFrame\n",
        "table = pd.read_sql_query(\"SELECT name FROM sqlite_master WHERE type='table';\", db)\n",
        "# Display the DataFrame\n",
        "table"
      ],
      "id": "d3053e2f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# SQL\n",
        "\n",
        "## select"
      ],
      "id": "26f44ae2"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Connect to the SQLite database\n",
        "db = sqlite3.connect('pythonsqlite.db')\n",
        "# Define an SQL query to select all columns from the 'tips' table, limiting to 3 rows\n",
        "sql=\"select * from tips LIMIT 3;\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the DataFrame\n",
        "table"
      ],
      "id": "74de438f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Renaming column"
      ],
      "id": "13d2ad09"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to select 'total_bill' and alias it as 'new_total_bill'\n",
        "sql=\"select total_bill as new_total_bill from tips\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the first 5 rows of the DataFrame\n",
        "table.head()"
      ],
      "id": "07a12504",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## create column"
      ],
      "id": "2c075f5b"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to select 'total_bill' as 'new_total_bill' and also the original 'total_bill'\n",
        "sql=\"select total_bill as new_total_bill,total_bill from tips\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the first 5 rows of the DataFrame\n",
        "table.head()"
      ],
      "id": "af7580b0",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Filter rows"
      ],
      "id": "438bbd82"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to select all columns from 'tips' where 'sex' is 'Male'\n",
        "sql=\"select * from tips where sex='Male'\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the first 5 rows of the DataFrame\n",
        "table.head()"
      ],
      "id": "13f9a452",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Filters with AND conditions"
      ],
      "id": "186d9edd"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to select all columns from 'tips' where 'sex' is 'Male' AND 'size' is greater than 3\n",
        "sql=\"select * from tips where sex='Male' and size>3\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the first 5 rows of the DataFrame\n",
        "table.head()"
      ],
      "id": "7d39c20d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Filters with or conditions"
      ],
      "id": "a164fd53"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to select all columns from 'tips' where 'sex' is 'Male' OR 'size' is greater than 3\n",
        "sql=\"select * from tips where sex='Male' or size>3\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the shape of the DataFrame (number of rows, number of columns)\n",
        "table.shape"
      ],
      "id": "645f043e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Append\n",
        "\n",
        "### append by row"
      ],
      "id": "ab3dc9ce"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to union all rows from 'tips' with itself\n",
        "sql=\"select * from tips UNION all select * from tips\"\n",
        "# Execute the SQL query and read the result into a pandas DataFrame\n",
        "table = pd.read_sql_query(sql,db)\n",
        "# Display the shape of the DataFrame\n",
        "table.shape"
      ],
      "id": "2e076a06",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
