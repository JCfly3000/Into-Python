    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define an SQL query to create a new table named 'new_tips' if it doesn't already exist, copying data from 'tips'\n",
        "sql=\"create table if not exists new_tips as select * from tips\"\n",
        "# Execute the SQL query\n",
        "db.execute(sql)\n",
        "\n",
        "# Execute an SQL query to select table names from sqlite_master and read into a pandas DataFrame\n",
        "table = pd.read_sql_query(\"SELECT name FROM sqlite_master WHERE type='table';\", db)\n",
        "# Display the DataFrame\n",
        "table"
      ],
      "id": "8d7c4f34",
      "execution_count": null,
      "outputs": []
