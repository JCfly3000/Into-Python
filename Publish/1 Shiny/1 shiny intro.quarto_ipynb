      "source": [
        "---\n",
        "title: \"shiny in Python introduction\"\n",
        "author: \"Tony Duan\"\n",
        "execute:\n",
        "  warning: false\n",
        "  error: false\n",
        "\n",
        "  \n",
        "format:\n",
        "  html:\n",
        "    toc: true\n",
        "    toc-location: right\n",
        "    code-fold: show\n",
        "    code-tools: true\n",
        "    \n",
        "    code-block-bg: true\n",
        "    code-block-border-left: \"#31BAE9\"\n",
        "    code-copy: true\n",
        "\n",
        "\n",
        "filters:\n",
        "  - shinylive\n",
        "  \n",
        "---\n"
      ],
      "id": "47caccc4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| eval: false\n",
        "pip install shiny"
      ],
      "id": "b90c813b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# if using shinylive(shiny without server) then install extension in your Quarto project"
      ],
      "id": "206fc899"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| eval: false\n",
        "quarto add quarto-ext/shinylive"
      ],
      "id": "bce7b442",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Add filters in YAML header\n",
        "\n",
        "````\n",
        "---\n",
        "\n",
        "filters:\n",
        "  - shinylive\n",
        "  \n",
        "---\n",
        "````\n",
        "\n",
        "# Shiny code\n",
        "\n",
        "````\n",
        "\n",
        "```{shinylive-python}\n",
        "#| standalone: true\n",
        "\n",
        "from shiny import *\n",
        "\n",
        "app_ui = ui.page_fluid(\n",
        "    ui.input_slider(\"n\", \"N\", 0, 100, 40),\n",
        "    ui.output_text_verbatim(\"txt\"),\n",
        ")\n",
        "\n",
        "\n",
        "def server(input, output, session):\n",
        "    @output\n",
        "    @render.text\n",
        "    def txt():\n",
        "        return f\"The value of n*2 is {input.n() * 2}\"\n",
        "\n",
        "app = App(app_ui, server)\n",
        "```\n",
        "\n",
        "````\n",
        "\n",
        "```{shinylive-python}\n",
        "#| standalone: true\n",
        "\n",
        "from shiny import *\n",
        "\n",
        "app_ui = ui.page_fluid(\n",
        "    ui.input_slider(\"n\", \"N\", 0, 100, 40),\n",
        "    ui.output_text_verbatim(\"txt\"),\n",
        ")\n",
        "\n",
        "\n",
        "def server(input, output, session):\n",
        "    @output\n",
        "    @render.text\n",
        "    def txt():\n",
        "        return f\"The value of n*2 is {input.n() * 2}\"\n",
        "\n",
        "app = App(app_ui, server)\n",
        "```\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "# Reference\n",
        "\n",
        "https://shiny.posit.co/py/get-started/shinylive.html\n"
      ],
      "id": "edd6acc0"
    }
  ],
